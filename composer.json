{
    "name": "technova69/html2spip",
    "description": "Conversion de HTML en raccourcis SPIP, y compris le HTML produit par SPIP (bibliothèque et plugin SPIP)",
    "type": "spip-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "masterminds/html5": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "spip/spip-cli": "dev-master"
    },
    "repositories": [
        {
            "name": "spip",
            "type": "composer",
            "url": "https://get.spip.net/composer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Html2Spip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Html2Spip\\Tests\\Unit\\": "tests/unit/",
            "Html2Spip\\Tests\\Integration\\": "tests/integration/",
            "Html2Spip\\Tests\\Outils\\": "tests/Outils/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "installer-spip-jetable": "bash scripts/installer-spip-jetable.sh",
        "capturer": "bash scripts/capturer.sh",
        "test-integration": "bash scripts/tester-integration.sh"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "php": "8.1.0"
        }
    }
}
